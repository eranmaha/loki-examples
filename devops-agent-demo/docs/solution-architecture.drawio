        <!-- Flow description -->
        <mxCell id="flow-desc" value="&lt;b&gt;Demo Flow:&lt;/b&gt;&lt;br&gt;1. User triggers fault injection (app errors)&lt;br&gt;2. App logs errors → OpenSearch&lt;br&gt;3. CloudWatch alarm fires → SNS → Webhook&lt;br&gt;4. DevOps Agent receives alert&lt;br&gt;5. Agent connects to MCP Server (private VPC)&lt;br&gt;6. Agent queries OpenSearch indexes&lt;br&gt;7. Agent investigates + remediates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161B22;strokeColor=#30363D;fontColor=#C9D1D9;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
