        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FF9900&quot;&gt;━━&lt;/font&gt; DevOps Agent flow&lt;br&gt;&lt;font color=&quot;#58A6FF&quot;&gt;━━&lt;/font&gt; Application flow&lt;br&gt;&lt;font color=&quot;#DA3633&quot;&gt;━━&lt;/font&gt; Fault injection&lt;br&gt;&lt;font color=&quot;#8C4FFF&quot;&gt;━━&lt;/font&gt; OpenSearch data&lt;br&gt;&lt;font color=&quot;#E7157B&quot;&gt;━━&lt;/font&gt; Monitoring / Alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#161B22;strokeColor=#30363D;fontColor=#C9D1D9;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
